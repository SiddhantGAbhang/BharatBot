<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    
    <!-- Inertia macros for common geometric shapes -->
    
    <!-- Cylinder inertia (for wheels, posts, etc.) -->
    <xacro:macro name="cylinder_inertia" params="m r h">
        <inertia ixx="${m*(3*r*r+h*h)/12}" 
                 ixy="0" 
                 ixz="0" 
                 iyy="${m*(3*r*r+h*h)/12}" 
                 iyz="0" 
                 izz="${m*r*r/2}" />
    </xacro:macro>

    <!-- Box inertia (for base, rectangular components) -->
    <xacro:macro name="box_inertia" params="m x y z">
        <inertia ixx="${m*(y*y+z*z)/12}" 
                 ixy="0" 
                 ixz="0" 
                 iyy="${m*(x*x+z*z)/12}" 
                 iyz="0" 
                 izz="${m*(x*x+y*y)/12}" />
    </xacro:macro>

    <!-- Sphere inertia (for ball joints, spherical components) -->
    <xacro:macro name="sphere_inertia" params="m r">
        <inertia ixx="${2*m*r*r/5}" 
                 ixy="0" 
                 ixz="0" 
                 iyy="${2*m*r*r/5}" 
                 iyz="0" 
                 izz="${2*m*r*r/5}" />
    </xacro:macro>
    
    <!-- Rod inertia (for thin rods, beams) -->
    <xacro:macro name="rod_inertia" params="m l">
        <inertia ixx="${m*l*l/12}" 
                 ixy="0" 
                 ixz="0" 
                 iyy="${m*l*l/12}" 
                 iyz="0" 
                 izz="0" />
    </xacro:macro>
    
    <!-- Point mass inertia (for very small components) -->
    <xacro:macro name="point_mass_inertia" params="m">
        <inertia ixx="0" 
                 ixy="0" 
                 ixz="0" 
                 iyy="0" 
                 iyz="0" 
                 izz="0" />
    </xacro:macro>
    
</robot>