<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Base link macro -->
    <xacro:macro name="base_link" params="parent">
        
        <!-- Base footprint - virtual link on the ground -->
        <link name="base_footprint"/>

        <!-- Base link - main body of the robot -->
        <link name="base_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://bharatbot_description/meshes/visual/base_link.dae" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://bharatbot_description/meshes/collision/base_link.stl" scale="1 1 1"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.02 0 0.028" rpy="0 0 0"/>
                <mass value="${base_mass}"/>
                <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
            </inertial>
        </link>

        <!-- Joint connecting base_footprint to base_link -->
        <joint name="base_link_fixed_joint" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0 0 ${wheel_diameter/2}" rpy="0 0 0"/>
        </joint>
        
    </xacro:macro>

</robot>