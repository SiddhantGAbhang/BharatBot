<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Camera Gazebo plugin macro -->
    <xacro:macro name="camera_gazebo" params="prefix">
        
        <!-- Camera Sensor and Gazebo properties -->
        <gazebo reference="${prefix}_camera_link">
            <!-- Camera Sensor -->
            <sensor name="camera" type="camera">
                <camera>
                    <horizontal_fov>1.3962634</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>15</far>
                    </clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.007</stddev>
                    </noise>
                    <optical_frame_id>${prefix}_camera_link_optical</optical_frame_id>
                    <camera_info_topic>camera/camera_info</camera_info_topic>
                </camera>
                <always_on>1</always_on>
                <update_rate>20</update_rate>
                <visualize>true</visualize>
                <topic>camera/image</topic>
            </sensor>
        </gazebo>
        
    </xacro:macro>
    
    <!-- Wide Angle Camera Gazebo plugin macro (optional) -->
    <!-- Uncomment and use this instead of standard camera for fisheye lens effect -->
    <!--
